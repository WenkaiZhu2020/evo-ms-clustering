    graph [color="#A6A6A6", fontname="Helvetica-Bold", fontsize=9, label="C07 - Lowest-contributing cluster\n1 class    q_c = 0.000000    W_in = 0    W_boundary = 0", labeljust="l", labelloc="t", margin=14, penwidth=1.1, style="rounded"];
    "low_01" [color="#4472A5", fillcolor="#DCEAF7", fontsize=8, label="DOMASException", tooltip="org.apache.xerces.dom3.as.DOMASException"];
    "isolated_note" [color="transparent", fillcolor="transparent", fontcolor="#555555", fontsize=8, label="Isolated singleton\nNo internal or boundary relations", shape="plain", style=""];
    "low_01" -> "isolated_note" [style="invis", weight=5];
  }
  subgraph cluster_legend {
    graph [color="#D0D0D0", fontname="Helvetica-Bold", fontsize=8, label="Legend", labeljust="l", margin=10, style="rounded"];
    "legend_package" [color="#4472A5", fillcolor="#DCEAF7", fontsize=7.5, label="Focal package node\nsize = focal class count"];
    "legend_external" [color="#888888", fillcolor="#F2F2F2", fontsize=7.5, label="External cluster summary", style="rounded,dashed,filled"];
    "legend_relations" [color="transparent", fillcolor="transparent", fontsize=7.5, label="Solid edge = aggregated internal structural weight\nDashed edge = aggregated boundary weight", shape="plain", style=""];
  }
  "shared_note" [color="transparent", fillcolor="transparent", fontname="Helvetica-Bold", fontsize=9, label="Stage 1 and Stage 3 select the same highest- and lowest-contributing clusters.", shape="plain", style=""];
  "audit_note" [color="transparent", fillcolor="transparent", fontcolor="#555555", fontsize=7.5, label="Complete class-level membership and edge data are provided in companion CSV files.", shape="plain", style=""];
}
